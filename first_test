import sqlite3

#===
# 1.initialize
#===

"""
This script initializes a SQLite database.
Include:
1. Create a new SQLite database file.
2. Create connection and cursor to the database.
"""

def create_database():
    """Create a new SQLite database and return a path of the database file."""
    path = input("Enter the name of the database file (e.g., students): ")
    db_file = f"{path}.db"
    return db_file

def create_connection(db_file):
    """Create a database connection to the SQLite database specified by db_file."""
    conn = sqlite3.connect(db_file)
    cur = conn.cursor()
    return conn, cur


#===
# 2.create table
#===

def create_table(cur, table_name):
    """Create a table in the SQLite database."""
    cur.execute("""
        CREATE TABLE IF NOT EXISTS ? (
            Id INTEGER PRIMARY KEY AUTOINCREMENT,
            Type TEXT NOT NULL,
            Amount REAL NOT NULL,
            Date TEXT NOT NULL
        )
    """, (table_name,))

    cur.connection.commit()

    return f"Table '{table_name}' created successfully."

def add_record(cur, table_name, record):
    """Add a record to the specified table in the SQLite database."""
    cur.execute("""
        INSERT INTO ? (Type, Amount, Date)
        VALUES (?, ?, ?)
    """, (table_name, record[0], record[1], record[2]))

    cur.connection.commit()

    return f"Record added to table '{table_name}' successfully."
