"""
This script initializes a SQLite database.
Include:
1. Create a new SQLite database file.
2. Create connection and cursor to the database.
"""

def create_database():
    """Create a new SQLite database and return a path of the database file."""
    path = input("Enter the name of the database file (e.g., students): ")
    db_file = f"{path}.db"
    return db_file

def create_connection(db_file):
    """Create a database connection to the SQLite database specified by db_file."""
    conn = sqlite3.connect(db_file)
    cur = conn.cursor()
    return conn, cur


